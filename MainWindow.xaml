<Window x:Class="HeadphoneHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeadphoneHub"
        Title="Headphone Hub" Width="428" Height="690"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{Binding Font, Source={x:Static local:Loc.I}}"
        FlowDirection="{Binding Flow, Source={x:Static local:Loc.I}}"
        FontSize="13" Foreground="{DynamicResource Label}" PreviewKeyDown="OnKey">

    <Grid x:Name="Root" Margin="14" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94"/>
        </Grid.RenderTransform>

        <Border CornerRadius="28" Background="{DynamicResource Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.35"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="48" Background="Transparent" FlowDirection="LeftToRight"
                  MouseLeftButtonDown="OnDrag">
                <Border Width="76" Height="28" CornerRadius="14" Background="{DynamicResource Pill}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"
                        Cursor="Hand" MouseLeftButtonDown="OnLang">
                    <Grid>
                        <Border Width="34" HorizontalAlignment="Left" Margin="2" CornerRadius="12" Background="{DynamicResource PillThumb}">
                            <Border.RenderTransform><TranslateTransform x:Name="LangT" X="0"/></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2"/>
                            </Border.Effect>
                        </Border>
                        <UniformGrid Columns="2">
                            <TextBlock x:Name="LabelEn" Text="EN" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource Label}"/>
                            <TextBlock x:Name="LabelFa" Text="فا" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="/Fonts/#Vazirmatn" Foreground="{DynamicResource Label}"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="104,0,0,0">
                    <Grid Width="20" Height="20" Margin="2,0" Cursor="Hand" Tag="blue" MouseLeftButtonDown="OnAccent">
                        <Ellipse x:Name="RingBlue" Stroke="{DynamicResource Label}" StrokeThickness="1.6"/>
                        <Ellipse Width="14" Height="14" Fill="#007AFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="20" Height="20" Margin="2,0" Cursor="Hand" Tag="red" MouseLeftButtonDown="OnAccent">
                        <Ellipse x:Name="RingRed" Stroke="{DynamicResource Label}" StrokeThickness="1.6"/>
                        <Ellipse Width="14" Height="14" Fill="#FF3B30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="20" Height="20" Margin="2,0" Cursor="Hand" Tag="green" MouseLeftButtonDown="OnAccent">
                        <Ellipse x:Name="RingGreen" Stroke="{DynamicResource Label}" StrokeThickness="1.6"/>
                        <Ellipse Width="14" Height="14" Fill="#34C759" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="20" Height="20" Margin="2,0" Cursor="Hand" Tag="yellow" MouseLeftButtonDown="OnAccent">
                        <Ellipse x:Name="RingYellow" Stroke="{DynamicResource Label}" StrokeThickness="1.6"/>
                        <Ellipse Width="14" Height="14" Fill="#FFCC00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="20" Height="20" Margin="2,0" Cursor="Hand" Tag="orange" MouseLeftButtonDown="OnAccent">
                        <Ellipse x:Name="RingOrange" Stroke="{DynamicResource Label}" StrokeThickness="1.6"/>
                        <Ellipse Width="14" Height="14" Fill="#FF9500" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="20" Height="20" Margin="2,0" Cursor="Hand" Tag="pink" MouseLeftButtonDown="OnAccent">
                        <Ellipse x:Name="RingPink" Stroke="{DynamicResource Label}" StrokeThickness="1.6"/>
                        <Ellipse Width="14" Height="14" Fill="#FF2D55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Style="{StaticResource IconBtn}" Click="OnTheme" Margin="0,0,4,0">
                        <Grid Width="18" Height="18">
                            <ContentControl x:Name="ThemeSys" Style="{StaticResource Icon}" Tag="{StaticResource G.Monitor}" RenderTransformOrigin="0.5,0.5">
                                <ContentControl.RenderTransform><ScaleTransform x:Name="ThemeSysS"/></ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="ThemeLight" Style="{StaticResource Icon}" Tag="{StaticResource G.Sun}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                <ContentControl.RenderTransform><ScaleTransform x:Name="ThemeLightS" ScaleX="0.4" ScaleY="0.4"/></ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="ThemeDark" Style="{StaticResource Icon}" Tag="{StaticResource G.Moon}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                <ContentControl.RenderTransform><ScaleTransform x:Name="ThemeDarkS" ScaleX="0.4" ScaleY="0.4"/></ContentControl.RenderTransform>
                            </ContentControl>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="OnMinimize" Margin="0,0,4,0">
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource G.Minus}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource CloseBtn}" Click="OnClose">
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource G.Close}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                          PreviewMouseWheel="OnWheel" ScrollChanged="OnScrollChanged">
                <StackPanel x:Name="Stack" Margin="18,0,18,28">

                    <Grid Margin="4,0,4,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Accent}"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource G.Headphones}"
                                                Foreground="White" Width="24" Height="24"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Title], Source={x:Static local:Loc.I}}"
                                       FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Label}"/>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Secondary}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource IconBtn}" Background="{DynamicResource Card}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh">
                            <Button.RenderTransform>
                                <RotateTransform x:Name="RefreshRot" CenterX="15" CenterY="15"/>
                            </Button.RenderTransform>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource G.Refresh}" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <local:SpectrumView x:Name="Viz" Height="96" CornerRadius="20" Margin="0,0,0,12" Fill="{DynamicResource VizBg}"/>

                    <Border Background="{DynamicResource Card}" CornerRadius="20" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                    <TextBlock Text="{Binding [Share], Source={x:Static local:Loc.I}}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Label}"/>
                                    <TextBlock Text="{Binding [ShareSub], Source={x:Static local:Loc.I}}"
                                               Foreground="{DynamicResource Secondary}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource IOSSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding IsRunning, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock Text="{Binding [Primary], Source={x:Static local:Loc.I}}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Secondary}" Margin="0,14,0,3"/>
                            <TextBlock Text="{Binding PrimaryName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Info}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource Secondary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#FF9500" FontSize="12" Margin="8,0,8,4"/>

                    <Grid Margin="8,10,4,8">
                        <TextBlock Text="{Binding [Outputs], Source={x:Static local:Loc.I}}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding [HideVirtual], Source={x:Static local:Loc.I}}" FontSize="12"
                                       Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton Style="{StaticResource IOSSwitch}" IsChecked="{Binding HideVirtual, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="WebCard" Background="{DynamicResource Card}" CornerRadius="20" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource Accent}">
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource G.Globe}" Foreground="White"
                                                    Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Web], Source={x:Static local:Loc.I}}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Label}"/>
                                    <TextBlock Text="{Binding WebSub}" FontSize="11.5" Foreground="{DynamicResource Secondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="2" Click="OnQr" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                            <Setter Property="Width" Value="0"/>
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Background" Value="{DynamicResource Bg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WebEnabled}" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,10,0" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource G.Qr}" Width="16" Height="16"/>
                                </Button>

                                <Button x:Name="WebToggle" Grid.Column="3" Style="{StaticResource WebSwitch}" Click="OnWebToggle"/>
                            </Grid>

                            <StackPanel ClipToBounds="True">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="MaxHeight" Value="0"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WebEnabled}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="200" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                                                    </Storyboard></BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                    </Storyboard></BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{Binding [Volume], Source={x:Static local:Loc.I}}" Foreground="{DynamicResource Secondary}"/>
                                    <TextBlock Text="{Binding WebVolumeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Secondary}"/>
                                </Grid>
                                <Slider Style="{StaticResource IOSSlider}" Minimum="0" Maximum="100" Value="{Binding WebVolume, Mode=TwoWay}"/>

                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding [WebPort], Source={x:Static local:Loc.I}}" Foreground="{DynamicResource Secondary}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight">
                                        <Border Background="{DynamicResource Bg}" CornerRadius="10" Width="84" Height="28">
                                            <Grid>
                                                <TextBox x:Name="PortBox" Style="{StaticResource PortBox}" MaxLength="5"
                                                         Text="{Binding WebPortText, UpdateSourceTrigger=LostFocus}"
                                                         PreviewTextInput="OnPortInput" KeyDown="OnPortKey"/>
                                                <TextBlock Text="{Binding [WebPortRandom], Source={x:Static local:Loc.I}}" FontSize="11.5"
                                                           Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=PortBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <Button Style="{StaticResource PillBtn}" Margin="6,0,0,0" Padding="10,4" FontSize="11.5"
                                                Background="{DynamicResource Bg}" Foreground="{DynamicResource Label}" Click="OnRandomPort"
                                                Content="{Binding [WebPortRandom], Source={x:Static local:Loc.I}}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource Bg}" CornerRadius="10" Padding="10,6" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding WebUrl}" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardRoot" Background="{DynamicResource Card}" CornerRadius="20"
                                        Padding="14" Margin="0,0,0,10" Opacity="0" Loaded="OnCardLoaded">
                                    <Border.RenderTransform><TranslateTransform x:Name="CardT" Y="16"/></Border.RenderTransform>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource Accent}">
                                                <ContentControl Foreground="White" Width="20" Height="20"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="Tag" Value="{StaticResource G.Speaker}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBluetooth}" Value="True">
                                                                    <Setter Property="Tag" Value="{StaticResource G.Headphones}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BaseName}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="{DynamicResource Secondary}"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource Bg}" CornerRadius="10"
                                                    Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BatteryText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Label}"/>
                                            </Border>

                                            <ToggleButton Grid.Column="3" Style="{StaticResource IOSSwitch}"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                        </Grid>

                                        <StackPanel ClipToBounds="True">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="MaxHeight" Value="0"/>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard><Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="130" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                                                                </Storyboard></BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard><Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                </Storyboard></BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid Margin="0,14,0,0">
                                                <TextBlock Text="{Binding [Volume], Source={x:Static local:Loc.I}}" Foreground="{DynamicResource Secondary}"/>
                                                <TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Secondary}"/>
                                            </Grid>
                                            <Slider Style="{StaticResource IOSSlider}" Minimum="0" Maximum="100"
                                                    Value="{Binding Volume, Mode=TwoWay}"/>

                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding [Delay], Source={x:Static local:Loc.I}}" Foreground="{DynamicResource Secondary}"/>
                                                <TextBlock Text="{Binding DelayText}" HorizontalAlignment="Right" Foreground="{DynamicResource Secondary}"/>
                                            </Grid>
                                            <Slider Style="{StaticResource IOSSlider}" Minimum="0" Maximum="1000"
                                                    Value="{Binding DelayMs, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False" CornerRadius="0,0,28,28" Background="{DynamicResource Fade}"/>
        </Grid>

        <Border x:Name="QrOverlay" CornerRadius="28" Background="#B3000000" Visibility="Collapsed" Opacity="0"
                MouseLeftButtonDown="OnQrBackdrop">
            <Border x:Name="QrCard" Background="{DynamicResource Card}" CornerRadius="24" Padding="20" Margin="26,0"
                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="OnQrCard">
                <Border.RenderTransform><ScaleTransform x:Name="QrScale" ScaleX="0.9" ScaleY="0.9"/></Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="{Binding [QrTitle], Source={x:Static local:Loc.I}}" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Label}"/>
                    <TextBlock Text="{Binding [QrStep], Source={x:Static local:Loc.I}}" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource Secondary}" Margin="0,6,0,14"/>

                    <Border Background="White" CornerRadius="16" Padding="10" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Width="200" Height="200" RenderOptions.EdgeMode="Aliased"/>
                    </Border>

                    <Border Background="{DynamicResource Bg}" CornerRadius="12" Padding="10,7" Margin="0,14,0,0">
                        <TextBlock Text="{Binding WebUrl}" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <TextBlock Text="{Binding [QrFirewall], Source={x:Static local:Loc.I}}" FontSize="11" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource Secondary}" Margin="0,10,0,0"/>

                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource PillBtn}" Margin="0,0,5,0" Click="OnCopyLink">
                            <Grid>
                                <TextBlock x:Name="CopyLabel" Text="{Binding [CopyLink], Source={x:Static local:Loc.I}}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CopiedLabel" Text="{Binding [Copied], Source={x:Static local:Loc.I}}" HorizontalAlignment="Center" Opacity="0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PillBtn}" Margin="5,0,0,0" Background="{DynamicResource Fill}"
                                Foreground="{DynamicResource Label}" Click="OnQrCloseClick"
                                Content="{Binding [Close], Source={x:Static local:Loc.I}}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="PortOverlay" CornerRadius="28" Background="#B3000000" Visibility="Collapsed" Opacity="0"
                MouseLeftButtonDown="OnPortBackdrop">
            <Border Background="{DynamicResource Card}" CornerRadius="24" Padding="20" Margin="26,0"
                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="OnQrCard">
                <Border.RenderTransform><ScaleTransform x:Name="PortScale" ScaleX="0.9" ScaleY="0.9"/></Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="{Binding [PortTitle], Source={x:Static local:Loc.I}}" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Label}"/>
                    <TextBlock Text="{Binding [PortSub], Source={x:Static local:Loc.I}}" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource Secondary}" Margin="0,6,0,14"/>

                    <Button Style="{StaticResource PillBtn}" Click="OnPromptRandom"
                            Content="{Binding [PortRandomGo], Source={x:Static local:Loc.I}}"/>

                    <TextBlock Text="{Binding [PortOr], Source={x:Static local:Loc.I}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Secondary}" Margin="0,10,0,10"/>

                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Bg}" CornerRadius="14" Height="40">
                            <Grid>
                                <TextBox x:Name="PromptBox" Style="{StaticResource PortBox}" FontSize="15" MaxLength="5"
                                         PreviewTextInput="OnPortInput" PreviewKeyDown="OnPromptKey" TextChanged="OnPromptChanged"/>
                                <TextBlock Text="{Binding [PortHolder], Source={x:Static local:Loc.I}}" FontSize="13"
                                           Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PromptBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource PillBtn}" Margin="8,0,0,0" Padding="18,10"
                                Click="OnPromptEnter" Content="{Binding [PortEnter], Source={x:Static local:Loc.I}}"/>
                    </Grid>

                    <TextBlock x:Name="PromptError" Text="{Binding [WebPortInvalid], Source={x:Static local:Loc.I}}" FontSize="11.5"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF9500" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <Button Style="{StaticResource PillBtn}" Margin="0,14,0,0" Background="{DynamicResource Fill}"
                            Foreground="{DynamicResource Label}" Click="OnPromptCancel"
                            Content="{Binding [Cancel], Source={x:Static local:Loc.I}}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
